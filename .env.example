# Логин Hik-Connect (облако) — ваш аккаунт
HIK_USER=your-hikconnect-login
HIK_PASSWORD=your-hikconnect-password

# Платформа облака: hikconnect (дефолт) | ezviz
HIK_PLATFORM=hikconnect

# Тег образа: 0.<ГГ><ММ><ДД>.<ЧЧ> — дата/время сборки (обязательно, без latest).
# Сгенерируйте в момент сборки:
#   HIKCLOUD2GORTC_TAG=0.$(date %y%m%d.%H)     # → напр. 0.261020.00
HIKCLOUD2GORTC_TAG=0.261020.00

# PacedWriter: сглаживание кадровых bursts облака (GOP приходит за раз, пауза ~2 с).
#   1 (по умолчанию) — ровный поток, плавная картинка (буфер ~1 с)
#   0                — минимальная задержка, но 2-с застытия при GOP-передачах
PACE_FRAMES=0

# Режим воркеров:
#   always (по умолчанию) — воркеры 24/7: тёплый поток, постоянный трафик
#     (~18 ГБ/день на main-камеру, ~1.2 ГБ/день на sub)
#   idle — воркер убивается через WORKER_IDLE_TIMEOUT с без клиентов:
#     трафик только вокруг опросов (сценарий «звонок в домофон»,
#     разбудить воркер заранее: GET /prime?channel=N)
WORKER_MODE=idle

# Сколько секунд без клиентов держать воркер (только в режиме idle).
WORKER_IDLE_TIMEOUT=90

# Как /snapshot и /frame отвечают, когда камера недоступна:
#   error    — HTTP 502 «snapshot failed: ...» / 502 воркера / 504 no-keyframe
#   nosignal — 200 + JPEG «NO SIGNAL / камера оффлайн» + X-Error/X-Error-Reason
OFFLINE_RESPONSE=error

# Часовой пояс контейнера (время в шапке /preview, логи), TZ-имя IANA
TZ=Europe/Minsk
